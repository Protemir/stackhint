{
  "description": "stackhint: quiet tool suggestions at session start (balanced mode) and for new tasks (proactive mode only). Turn off with: stackhint config set mode manual",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook session-start",
            "timeout": 10,
            "commandWindows": "node \"%CLAUDE_PLUGIN_ROOT%/dist/cli.js\" hook session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook user-prompt",
            "timeout": 5,
            "commandWindows": "node \"%CLAUDE_PLUGIN_ROOT%/dist/cli.js\" hook user-prompt"
          }
        ]
      }
    ]
  }
}
